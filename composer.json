{
    "name": "shippercli/provider-forge",
    "description": "Laravel Forge provider for Shipper CLI",
    "type": "shipper-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/forge-sdk": "^4.0",
        "shippercli/contracts": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "ShipperCli\\ProviderForge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ShipperCli\\ProviderForge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php vendor/bin/pest"
    },
    "extra": {
        "shipper-plugin": "ShipperCli\\ProviderForge\\ForgePlugin"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "pestphp/pest": "^3.8"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        }
    }
}
